<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CalculatorApp.MainWindow"
        Title="Kalkulator App"
        Width="300" Height="400">
  <StackPanel Margin="10">
    
    <!-- Tampilan hasil -->
    <Canvas Name="DisplayCanvas" Height="60" Background="#eee" />

    <!-- Tombol kalkulator -->
    <Grid Margin="0,10,0,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,*,*">
      <!-- Baris 1 -->
      <Button Content="7" Grid.Row="0" Grid.Column="0" Click="Button_Click"/>
      <Button Content="8" Grid.Row="0" Grid.Column="1" Click="Button_Click"/>
      <Button Content="9" Grid.Row="0" Grid.Column="2" Click="Button_Click"/>
      <Button Content="/" Grid.Row="0" Grid.Column="3" Click="Button_Click"/>

      <!-- Baris 2 -->
      <Button Content="4" Grid.Row="1" Grid.Column="0" Click="Button_Click"/>
      <Button Content="5" Grid.Row="1" Grid.Column="1" Click="Button_Click"/>
      <Button Content="6" Grid.Row="1" Grid.Column="2" Click="Button_Click"/>
      <Button Content="*" Grid.Row="1" Grid.Column="3" Click="Button_Click"/>

      <!-- Baris 3 -->
      <Button Content="1" Grid.Row="2" Grid.Column="0" Click="Button_Click"/>
      <Button Content="2" Grid.Row="2" Grid.Column="1" Click="Button_Click"/>
      <Button Content="3" Grid.Row="2" Grid.Column="2" Click="Button_Click"/>
      <Button Content="-" Grid.Row="2" Grid.Column="3" Click="Button_Click"/>

      <!-- Baris 4 -->
      <Button Content="0" Grid.Row="3" Grid.Column="0" Click="Button_Click"/>
      <Button Content="." Grid.Row="3" Grid.Column="1" Click="Button_Click"/>
      <Button Content="C" Grid.Row="3" Grid.Column="2" Click="Clear_Click"/>
      <Button Content="+" Grid.Row="3" Grid.Column="3" Click="Button_Click"/>

      <!-- Baris 5: tombol "=" ambil 4 kolom -->
      <Button Content="=" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
              FontSize="16" FontWeight="Bold" Height="40"
              Click="Equals_Click"/>
    </Grid>

  </StackPanel>
</Window>
